{
    "editor.insertSpaces": true,
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "qmk.json": "jsonc"
    },
    "files.exclude": {
        "**/.build": true,
        "**/*.hex": true,
        "**/*.bin": true,
        "**/*.uf2": true
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--header-insertion=never"
    ],
    "makefile.configureOnOpen": false,
    "cSpell.languageSettings": [
        {
            "languageId": "c",
            "ignoreRegExpList": [
                "/\\b[A-Z][A-Z0-9_]*\\b/g"
            ]
        }
    ],
    "cSpell.words": [
        "ACTN",
        "compiledb",
        "corneliuskbd",
        "foostan",
        "getreuer",
        "HRDWR",
        "keymap",
        "keymap's",
        "keymaps",
        "NUMNAV",
        "QWRTY",
        "SYMBL",
        "userspace"
    ]
}
