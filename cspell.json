{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    "modules/getreuer/**",
    "vendor/**",
    "LICENSE",
    ".clangd"
  ],
  "ignoreRegExpList": [
    "/-D[A-Z][A-Z0-9_]*/g"
  ],
  "languageSettings": [
    {
      "languageId": "c,cpp,makefile",
      "ignoreRegExpList": [
        "/\\b[A-Z][A-Z0-9_]*\\b/g"
      ]
    }
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "project-words"
  ]
}
