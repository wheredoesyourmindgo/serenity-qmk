{
    "editor.insertSpaces": true,
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "qmk.json": "jsonc"
    },
    "files.exclude": {
        "**/.build": true,
        "**/*.hex": true,
        "**/*.bin": true,
        "**/*.uf2": true
    },
    "clangd.arguments": [
        "--header-insertion=never"
    ],
    "makefile.configureOnOpen": false
}
